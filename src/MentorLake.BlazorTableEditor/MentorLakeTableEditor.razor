@using MentorLake.BlazorTableEditor.Models

<div class="bte-root @(_isResizingCol ? "is-col-resizing" : null) @(_isResizingRow ? "is-row-resizing" : null)"
     tabindex="0"
     @ref="_rootRef"
     data-anchor-row="@Context.SelectionAnchor.Row"
     data-anchor-col="@Context.SelectionAnchor.Col"
     data-active-row="@Context.ActiveCell.Row"
     data-active-col="@Context.ActiveCell.Col"
     data-sel-r0="@(Context.CurrentSelection?.Normalize().StartRow ?? Context.ActiveCell.Row)"
     data-sel-r1="@(Context.CurrentSelection?.Normalize().EndRow ?? Context.ActiveCell.Row)"
     data-sel-c0="@(Context.CurrentSelection?.Normalize().StartCol ?? Context.ActiveCell.Col)"
     data-sel-c1="@(Context.CurrentSelection?.Normalize().EndCol ?? Context.ActiveCell.Col)"
     @onkeydown="OnKeyDown"
     @onmouseup="OnGlobalMouseUp"
     @onmouseleave="OnRootMouseLeave"
     @oncontextmenu="OnRootContextMenu"
     @oncontextmenu:preventDefault="true">

	@if (ShowToolbar)
	{
		<TableToolbar Sheet="Context"
		              CsvStatus="_csvStatus"
		              OnUndo="UndoAsync"
		              OnRedo="RedoAsync"
		              OnCut="CutAsync"
		              OnCopy="CopyAsync"
		              OnPaste="PasteAsync"
		              OnExportCsv="ExportCsvAsync"
		              OnImportCsv="TriggerCsvImport"
		              OnCsvFileSelected="OnCsvFileSelected"
		              OnStructureChanged="OnToolbarStructureChanged" />
	}

	<div class="bte-sheet">
		<div class="bte-viewport" @ref="_viewportRef" @onscroll="OnViewportScroll">
			<div class="bte-canvas"
			     style="@($"width:{SheetContext.RowHeaderWidth + Context.GetTotalWidth()}px;height:{SheetContext.ColumnHeaderHeight + Context.GetTotalHeight()}px;")"
			     @onmousemove="OnCanvasMouseMove"
			     @onmouseup="OnGlobalMouseUp">

				<TableColumnHeaders Sheet="Context"
				                    FirstCol="_firstCol"
				                    LastCol="_lastCol"
				                    PressedColHeader="_pressedColHeader"
				                    EditingColumnIndex="@(IsEditingColumnHeaderActive() ? _headerEditIndex : null)"
				                    @bind-EditValue="_editValue"
				                    OnColMouseDown="OnColHeaderMouseDownFromChild"
				                    OnHeaderMouseUp="OnHeaderMouseUp"
				                    OnDoubleClick="OnColHeaderDoubleClick"
				                    OnContextMenu="OnColHeaderContextMenu"
				                    OnFilterClick="OnColFilterClick"
				                    OnCommit="CommitEdit"
				                    OnKeyDown="OnHeaderEditorKeyDown" />

				<div class="bte-body-area"
				     style="@($"height:{Context.GetTotalHeight()}px;width:{SheetContext.RowHeaderWidth + Context.GetTotalWidth()}px;")">
					<TableRowHeaders Sheet="Context"
					                 FirstRow="_firstRow"
					                 LastRow="_lastRow"
					                 PressedRowHeader="_pressedRowHeader"
					                 OnRowMouseDown="OnRowHeaderMouseDownFromChild"
					                 OnHeaderMouseUp="OnHeaderMouseUp"
					                 OnContextMenu="OnRowHeaderContextMenu" />

					<TableCellGrid Sheet="Context"
					               FirstRow="_firstRow"
					               LastRow="_lastRow"
					               FirstCol="_firstCol"
					               LastCol="_lastCol"
					               ClipboardSource="_clipboardSource"
					               ClipboardMode="_clipboardMode"
					               OnCellMouseDown="OnCellMouseDownFromChild"
					               OnCellMouseEnter="OnCellMouseEnterFromChild"
					               OnDoubleClick="OnCellDoubleClickFromChild"
					               OnContextMenu="OnCellContextMenuFromChild"
					               OnDropdownChanged="OnDropdownChangedFromChild">
						<TableSelectionOverlay Sheet="Context"
						                       OnFillHandleMouseDown="OnFillHandleMouseDown" />

						<TableCellEditor Sheet="Context"
						                 IsEditing="_isEditing && !IsEditingHeader"
						                 Position="_editPos"
						                 @bind-Value="_editValue"
						                 OnCommit="CommitEdit"
						                 OnKeyDown="OnEditorKeyDown" />
					</TableCellGrid>
				</div>
			</div>
		</div>
	</div>

	<TableContextMenu @ref="_contextMenu"
	                  Sheet="Context"
	                  OnStructureChanged="OnContextMenuStructureChanged"
	                  OnRenameColumn="OnContextMenuRenameColumn"
	                  OnCut="CutAsync"
	                  OnCopy="CopyAsync"
	                  OnPaste="PasteAsync" />

	<TableColumnFilterPopup @ref="_filterPopup"
	                        Sheet="Context"
	                        OnFilterChanged="OnFilterChanged" />
</div>
