@using MentorLake.BlazorTableEditor.Models

<div id="@PopoverId"
     @ref="_popoverRef"
     popover
     class="bte-vv-dropdown"
     style="@DropdownStyle"
     @onmousedown:stopPropagation="true"
     @onclick:stopPropagation="true"
     @onkeydown:stopPropagation="true">
	@{
		var current = _currentValue ?? string.Empty;
		var currentInList = _options.Count > 0 && ContainsValue(_options, current);
		var itemIndex = 0;
	}

	@if (_options.Count > 0)
	{
		var blankIndex = itemIndex++;
		<button type="button"
		        class="bte-vv-option @(current.Length == 0 ? "is-selected" : null) @(_isOpen && _highlightIndex == blankIndex ? "is-highlighted" : null)"
		        popovertarget="@PopoverId"
		        @onclick="() => SelectAsync(string.Empty)">
			<span class="bte-vv-option-label bte-vv-option-blank">&nbsp;</span>
		</button>

		@if (current.Length > 0 && !currentInList)
		{
			var invalidIndex = itemIndex++;
			<button type="button"
			        class="bte-vv-option is-selected is-invalid @(_isOpen && _highlightIndex == invalidIndex ? "is-highlighted" : null)"
			        popovertarget="@PopoverId"
			        @onclick="() => SelectAsync(current)">
				<span class="bte-vv-option-label" title="@current">@current</span>
			</button>
		}

		@foreach (var option in _options)
		{
			var value = option.Value;
			var selected = string.Equals(value, current, StringComparison.Ordinal);
			var optionIndex = itemIndex++;
			<button type="button"
			        class="bte-vv-option @(selected ? "is-selected" : null) @(_isOpen && _highlightIndex == optionIndex ? "is-highlighted" : null)"
			        popovertarget="@PopoverId"
			        @onclick="() => SelectAsync(value)">
				<span class="bte-vv-option-label" title="@option.Display">@option.Display</span>
			</button>
		}
	}
</div>
