@using MentorLake.BlazorTableEditor.Models

<div class="bte-header-row"
     style="@($"height:{SheetContext.ColumnHeaderHeight}px;width:{SheetContext.RowHeaderWidth + Sheet.GetTotalWidth()}px;")">
	<div class="bte-corner"
	     style="@($"width:{SheetContext.RowHeaderWidth}px;height:{SheetContext.ColumnHeaderHeight}px;")"></div>
	<div class="bte-col-track"
	     style="@($"left:{SheetContext.RowHeaderWidth}px;width:{Sheet.GetTotalWidth()}px;height:{SheetContext.ColumnHeaderHeight}px;")">
		@for (int c = FirstCol; c <= LastCol; c++)
		{
			var col = c;
			var left = Sheet.GetColumnLeft(col);
			var width = Sheet.GetColumnWidth(col);
			var colSelected = Sheet.IsColumnHeaderSelected(col);
			var colPressed = PressedColHeader == col;
			var editingColHeader = IsEditingColumn(col);
			var filtered = Sheet.IsColumnFiltered(col);
			<div
				class="bte-col-header @(colSelected ? "is-selected" : null) @(colPressed ? "is-pressed" : null) @(editingColHeader ? "is-editing" : null) @(filtered ? "is-filtered" : null)"
				role="button"
				tabindex="-1"
				data-col="@col"
				style="@($"left:{left}px;width:{width}px;height:{SheetContext.ColumnHeaderHeight}px;")"
				@onmousedown="e => OnColMouseDownAsync(col, e)"
				@onmouseup="OnHeaderMouseUpAsync"
				@onmouseleave="OnHeaderMouseUpAsync"
				@ondblclick="() => OnDoubleClickAsync(col)"
				@oncontextmenu="e => OnContextMenuAsync(col, e)"
				@oncontextmenu:preventDefault="true"
				@oncontextmenu:stopPropagation="true">
				@if (editingColHeader)
				{
					<input @ref="_headerEditorRef"
					       class="bte-header-editor"
					       value="@EditValue"
					       @oninput="OnEditInputAsync"
					       @onkeydown="OnEditorKeyDownAsync"
					       @onkeydown:stopPropagation="true"
					       @onmousedown:stopPropagation="true"
					       @ondblclick:stopPropagation="true"
					       @onblur="OnCommitAsync"/>
				}
				else
				{
					<span class="bte-header-label">@Sheet.Model.ColumnHeaders[col]</span>
					<button type="button"
					        class="bte-filter-btn-header @(filtered ? "is-active" : null)"
					        title="@(filtered ? "Filter applied" : "Filter")"
					        @onclick="e => OnFilterClickAsync(col, e)"
					        @onclick:stopPropagation="true"
					        @onmousedown:stopPropagation="true"
					        @ondblclick:stopPropagation="true">
						<svg class="bte-filter-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							@if (filtered)
							{
								<path d="M22 3H2L10 12.46V19L14 21V12.46L22 3Z" />
								@* <path d="M1.5 1.5h13l-5 7.5V14.5l-3-1.5V9L1.5 1.5z"/> *@
							}
							else
							{
								<path d="M22 3H2L10 12.46V19L14 21V12.46L22 3Z"  fill="none" stroke="currentColor" stroke-width="1.5" />
								@* <path d="M2 2h12l-4.5 7v4.5l-3-1.5V9L2 2z" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/> *@
							}
						</svg>
					</button>
				}
				<div class="bte-resize-col"></div>
			</div>
		}
	</div>
</div>
