@using MentorLake.BlazorTableEditor.Models

<div class="bte-cell-track"
     style="@($"left:{SheetContext.RowHeaderWidth}px;width:{Sheet.GetTotalWidth()}px;height:{Sheet.GetTotalHeight()}px;")">
	@for (int r = FirstRow; r <= LastRow; r++)
	{
		if (Sheet.IsRowHidden(r))
		{
			continue;
		}

		var row = r;
		var top = Sheet.GetRowTop(row);
		var height = Sheet.GetRowHeight(row);

		for (int c = FirstCol; c <= LastCol; c++)
		{
			var col = c;
			var left = Sheet.GetColumnLeft(col);
			var width = Sheet.GetColumnWidth(col);
			var isActive = Sheet.IsActive(row, col);
			var isSelected = Sheet.IsSelected(row, col);
			var inFill = Sheet.DragFillPreview?.Contains(new CellPosition(row, col)) == true
			             && !Sheet.IsSelected(row, col);
			var inClipboard = IsInClipboardSource(row, col);
			var hasError = Sheet.HasError(row, col);
			var cell = Sheet.GetValue(row, col);
			var hasSelect = Sheet.HasValidValuesForColumn(col);
			var display = Sheet.GetCellDisplay(row, col);
			var css = BuildCellClass(isActive, isSelected, inFill, inClipboard, ClipboardMode, hasError, hasSelect);
			var style = BuildCellStyle(left, top, width, height, cell);
			var title = hasError ? Sheet.GetError(row, col) : null;

			@if (hasSelect)
			{
				var anchorStyle = style + $"anchor-name:--bte-vv-r{row}c{col};";
				<button type="button"
				        class="@css"
				        style="@anchorStyle"
				        title="@title"
				        data-row="@row"
				        data-col="@col"
				        data-vv-trigger="1"
				        @onmousedown="e => OnCellMouseDownAsync(row, col, e)"
				        @onmouseenter="() => OnCellMouseEnterAsync(row, col)"
				        @ondblclick="() => OnDoubleClickAsync(row, col)"
				        @oncontextmenu="e => OnContextMenuAsync(row, col, e)"
				        @oncontextmenu:preventDefault="true"
				        @oncontextmenu:stopPropagation="true">
					<span class="bte-cell-value">@display</span>
					<span class="bte-cell-vv-caret" aria-hidden="true"></span>
				</button>
			}
			else
			{
				<div class="@css"
				     style="@style"
				     title="@title"
				     data-row="@row"
				     data-col="@col"
				     @onmousedown="e => OnCellMouseDownAsync(row, col, e)"
				     @onmouseenter="() => OnCellMouseEnterAsync(row, col)"
				     @ondblclick="() => OnDoubleClickAsync(row, col)"
				     @oncontextmenu="e => OnContextMenuAsync(row, col, e)"
				     @oncontextmenu:preventDefault="true"
				     @oncontextmenu:stopPropagation="true">
					@display
				</div>
			}
		}
	}

	@if (Sheet.IsDragFilling && Sheet.DragFillPreview is { } fill)
	{
		<div class="bte-fill-preview" style="@GetRegionBox(fill)"></div>
	}

	@if (ClipboardSource is { } clipSrc && ClipboardMode != ClipboardVisualMode.None)
	{
		<div class="@GetClipboardOverlayClass()" style="@GetRegionBox(clipSrc)" aria-hidden="true">
			<span class="bte-clipboard-badge">@GetClipboardBadgeText()</span>
		</div>
	}

	@ChildContent
</div>
