@page "/"
@rendermode InteractiveServer
@using MentorLake.BlazorTableEditor.Demo.Validators
@using MentorLake.BlazorTableEditor.Models

<PageTitle>Blazor Table Editor</PageTitle>


<div class="bte-page">
	<h1>Blazor Table Editor</h1>
	<p class="bte-lead">
		Click a cell to select. Drag to multi-select. Double-click or press Enter/F2 to edit.
		Arrow keys move the active cell; Shift+Arrow expands selection. Drag the fill handle to copy values.
		Use the filter button on a column header for Excel-style value filters.
		Columns with supplied valid values (Category, Status) show a dropdown in each cell; invalid values are marked with an error.
		Category options use a display label with a short stored code (e.g. Fruit → FR).
		Use <strong>Export CSV</strong> / <strong>Import CSV</strong> in the toolbar to save or load spreadsheet data.
		<code>ValidationChanged</code> updates the validation panel below whenever validation runs.
	</p>

	<button type="button" @onclick="OnShowHideEditor">Show/hide editor</button>
	<button type="button" @onclick="OnToggleReadOnly">@(_readOnly ? "Switch to editable" : "Switch to read-only")</button>
	<button type="button" @onclick="OnExportCsv">Export table to CSV</button>

	@if (_showEditor)
	{
		<div style="height: 600px; width: 1000px;">
			<MentorLake.BlazorTableEditor.MentorLakeTableEditor
				ReadOnly="_readOnly"
				Validator="_validator"
				ColumnValidValues="_columnValidValues"
				Model="_model"
				ModelChanged="OnModelChanged"
				ValidationChanged="OnValidationChanged"/>
		</div>
	}

	<section class="bte-validation-panel" aria-live="polite">
		<h2 class="bte-validation-title">ValidationChanged</h2>
		<p class="bte-validation-summary">
			@_validationErrors.Count error@(_validationErrors.Count == 1 ? "" : "s")
			@if (_validationCallbackCount > 0)
			{
				<span> · callback fired @_validationCallbackCount time@(_validationCallbackCount == 1 ? "" : "s")</span>
			}
		</p>
		@if (_validationErrors.Count == 0)
		{
			<p class="bte-validation-empty">No validation errors.</p>
		}
		else
		{
			<ul class="bte-validation-list">
				@foreach (var error in _validationErrors.OrderBy(e => e.Key.Row).ThenBy(e => e.Key.Col))
				{
					<li>
						<strong>R@(error.Key.Row + 1)C@(error.Key.Col + 1)</strong>: @error.Value
					</li>
				}
			</ul>
		}
	</section>

	<label class="bte-csv-label" for="csv-export">CSV export</label>
	<textarea id="csv-export" class="bte-csv-export" readonly rows="16">@_csvText</textarea>
</div>

@code {
	private bool _showEditor = true;
	private bool _readOnly;
	private string _csvText = string.Empty;
	private TableDataModel _model = CreateSampleModel();
	private readonly ITableValidator _validator = new DemoTableValidator();
	private IReadOnlyDictionary<CellPosition, string> _validationErrors =
		new Dictionary<CellPosition, string>();
	private int _validationCallbackCount;

	private readonly IReadOnlyDictionary<string, IReadOnlyList<ValidValueOption>> _columnValidValues =
		new Dictionary<string, IReadOnlyList<ValidValueOption>>(StringComparer.OrdinalIgnoreCase)
		{
			["Category"] = new ValidValueOption[]
			{
				new("FR", "Fruit"),
				new("VG", "Vegetable"),
				new("DY", "Dairy"),
				new("GR", "Grain")
			},
			["Status"] = ValidValueOption.FromValues("Open", "Closed", "Pending")
		};

	private void OnShowHideEditor()
	{
		_showEditor = !_showEditor;
	}

	private void OnToggleReadOnly()
	{
		_readOnly = !_readOnly;
	}

	private void OnModelChanged(TableDataModel model)
	{
		_model = model;
	}

	private void OnValidationChanged(IReadOnlyDictionary<CellPosition, string> errors)
	{
		_validationErrors = errors ?? new Dictionary<CellPosition, string>();
		_validationCallbackCount++;
	}

	private void OnExportCsv()
	{
		_csvText = _model.ToCsv(includeHeaders: true);
	}

	private static TableDataModel CreateSampleModel()
	{
		var model = new TableDataModel(100, 5);
		model.ColumnHeaders[0] = "Name";
		model.ColumnHeaders[1] = "Category";
		model.ColumnHeaders[2] = "Qty";
		model.ColumnHeaders[3] = "Status";
		model.ColumnHeaders[4] = "Notes";

		string[] names = ["Alpha", "Bravo", "Charlie", "Delta", "Echo", "Foxtrot", "Golf", "Hotel"];
		string[] categories = ["FR", "FR", "VG", "DY", "FR", "VG", "DY", "Unknown"];
		string[] qtys = ["12", "5", "20", "8", "15", "3", "3.14", "7"];
		string[] statuses = ["Open", "Closed", "Open", "Pending", "Open", "Closed", "Pending", "Open"];
		string[] notes = ["Hello", "", "Blazor Table Editor", "Rush", "", "Backorder", "Sample note", ""];

		for (var i = 0; i < names.Length; i++)
		{
			model.SetCell(i, 0, new CellValue(names[i]));
			model.SetCell(i, 1, new CellValue(categories[i]));
			model.SetCell(i, 2, new CellValue(qtys[i]));
			model.SetCell(i, 3, new CellValue(statuses[i]));
			if (!string.IsNullOrEmpty(notes[i]))
			{
				var note = new CellValue(notes[i]);
				if (i == 2)
				{
					note.BackgroundColor = "#e6f3ff";
				}

				model.SetCell(i, 4, note);
			}
		}

		return model;
	}
}
