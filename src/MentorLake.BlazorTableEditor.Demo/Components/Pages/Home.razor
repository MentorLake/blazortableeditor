@page "/"
@rendermode InteractiveServer
@using MentorLake.BlazorTableEditor.Demo.Validators
@using MentorLake.BlazorTableEditor.Models

<PageTitle>Blazor Table Editor</PageTitle>


<div class="bte-page">
	<h1>Blazor Table Editor</h1>
	<p class="bte-lead">
		Click a cell to select. Drag to multi-select. Double-click or press Enter/F2 to edit.
		Arrow keys move the active cell; Shift+Arrow expands selection. Drag the fill handle to copy values.
		Use the filter button on a column header for Excel-style value filters.
		Columns with supplied valid values (Category, Status) show a dropdown in each cell; invalid values are marked with an error.
		Category options use a display label with a short stored code (e.g. Fruit → FR).
		Use <strong>Export CSV</strong> / <strong>Import CSV</strong> in the toolbar to save or load spreadsheet data.
	</p>

	<button type="button" @onclick="OnShowHideEditor">Show/hide editor</button>
	<button type="button" @onclick="OnExportCsv">Export table to CSV</button>

	@if (_showEditor)
	{
		<div style="height: 600px; width: 1000px;">
			<MentorLake.BlazorTableEditor.MentorLakeTableEditor
				Validator="_validator"
				ColumnValidValues="_columnValidValues"
				Model="_model"
				ModelChanged="OnModelChanged"/>
		</div>
	}

	<label class="bte-csv-label" for="csv-export">CSV export</label>
	<textarea id="csv-export" class="bte-csv-export" readonly rows="16">@_csvText</textarea>
</div>

@code {
	private bool _showEditor = true;
	private string _csvText = string.Empty;
	private TableDataModel _model = new(100, 5);
	private readonly ITableValidator _validator = new DemoTableValidator();

	private readonly IReadOnlyDictionary<string, IReadOnlyList<ValidValueOption>> _columnValidValues =
		new Dictionary<string, IReadOnlyList<ValidValueOption>>(StringComparer.OrdinalIgnoreCase)
		{
			["Category"] = new ValidValueOption[]
			{
				new("FR", "Fruit"),
				new("VG", "Vegetable"),
				new("DY", "Dairy"),
				new("GR", "Grain")
			},
			["Status"] = ValidValueOption.FromValues("Open", "Closed", "Pending")
		};

	private void OnShowHideEditor()
	{
		_showEditor = !_showEditor;
	}

	private void OnModelChanged(TableDataModel model)
	{
		_model = model;
	}

	private void OnExportCsv()
	{
		_csvText = _model.ToCsv(includeHeaders: true);
	}
}
