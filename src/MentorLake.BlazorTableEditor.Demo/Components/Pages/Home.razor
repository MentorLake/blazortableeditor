@page "/"
@rendermode InteractiveServer
@using MentorLake.BlazorTableEditor.Demo.Validators
@using MentorLake.BlazorTableEditor.Models

<PageTitle>Blazor Table Editor</PageTitle>


<div class="bte-page">
	<h1>Blazor Table Editor</h1>
	<p class="bte-lead">
		Click a cell to select. Drag to multi-select. Double-click or press Enter/F2 to edit.
		Arrow keys move the active cell; Shift+Arrow expands selection. Drag the fill handle to copy values.
		Use the filter button on a column header for Excel-style value filters.
		Columns with supplied valid values (Category, Status) show a dropdown in each cell; invalid values are marked with an error.
		Use <strong>Export CSV</strong> / <strong>Import CSV</strong> in the toolbar to save or load spreadsheet data.
	</p>

	<button @onclick="OnShowHideEditor">Show/hide editor</button>

	@if (_showEditor)
	{
		<div style="height: 600px; width: 1000px;">
			<MentorLake.BlazorTableEditor.MentorLakeTableEditor
				Validator="_validator"
				ColumnValidValues="_columnValidValues"
				Model="@(new TableDataModel(100, 5))"/>
		</div>
	}
</div>

@code {
	private bool _showEditor = true;
	private readonly ITableValidator _validator = new DemoTableValidator();

	private readonly IReadOnlyDictionary<string, IReadOnlyList<string>> _columnValidValues =
		new Dictionary<string, IReadOnlyList<string>>(StringComparer.OrdinalIgnoreCase)
		{
			["Category"] = new[] { "Fruit", "Vegetable", "Dairy", "Grain" },
			["Status"] = new[] { "Open", "Closed", "Pending" }
		};

	private void OnShowHideEditor()
	{
		_showEditor = !_showEditor;
	}
}
